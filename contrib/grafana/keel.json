{
  "__inputs": [
    {
      "name": "DS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "state-timeline",
      "name": "State timeline",
      "version": ""
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "uid": "breaker-circuits",
  "title": "keel",
  "tags": [
    "breaker"
  ],
  "description": "State, load shed, trips and open circuits for every breaker, and decisions, refusals and errors for every rate limiter, published with breaker.Register and ratelimit.Register.",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "DS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "dependency",
        "label": "Dependency",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "query": {
          "query": "label_values(go_breaker_state, dependency)",
          "refId": "dependency"
        },
        "definition": "label_values(go_breaker_state, dependency)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "options": [],
        "regex": ""
      },
      {
        "name": "limiter",
        "label": "Limiter",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "query": {
          "query": "label_values(go_ratelimit_decisions_total, limiter)",
          "refId": "limiter"
        },
        "definition": "label_values(go_ratelimit_decisions_total, limiter)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "options": [],
        "regex": ""
      },
      {
        "name": "retrier",
        "label": "retrier",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "query": {
          "query": "label_values(go_retry_calls_total, retrier)",
          "refId": "retrier"
        },
        "definition": "label_values(go_retry_calls_total, retrier)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "options": [],
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Circuit open, fraction of instances",
      "description": "Per dependency: the share of instances whose circuit is open. Red across the row is the dependency being down; a thin sliver is one pod (often CPU-throttled). Inline equivalent of the breaker:open_fraction recording rule.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum by (dependency) (go_breaker_state{dependency=~\"$dependency\", state=\"open\"})\n  /\ncount by (dependency) (go_breaker_state{dependency=~\"$dependency\", state=\"closed\"})",
          "legendFormat": "{{dependency}}",
          "refId": "A"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.85,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Open now",
      "description": "Current fraction of instances open, per dependency.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum by (dependency) (go_breaker_state{dependency=~\"$dependency\", state=\"open\"})\n  /\ncount by (dependency) (go_breaker_state{dependency=~\"$dependency\", state=\"closed\"})",
          "legendFormat": "{{dependency}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "maxVizHeight": 300
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Load shed, share of calls refused",
      "description": "The user-facing symptom: calls that never ran because the circuit was open, the probe budget was exhausted, or the bulkhead was full.",
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 9,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum by (dependency) (rate(go_breaker_calls_total{dependency=~\"$dependency\", result=~\"rejected|shed\"}[$__rate_interval]))\n  /\nsum by (dependency) (rate(go_breaker_calls_total{dependency=~\"$dependency\"}[$__rate_interval]))",
          "legendFormat": "{{dependency}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Trips",
      "description": "Transitions to open per interval, summed across instances. A comb pattern is flapping: the backend is half-recovering, or IsFailure counts healthy answers as failures.",
      "gridPos": {
        "x": 15,
        "y": 8,
        "w": 9,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "sum by (dependency) (increase(go_breaker_trips_total{dependency=~\"$dependency\"}[$__rate_interval]))",
          "legendFormat": "{{dependency}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "In flight vs limit",
      "description": "Bulkhead headroom. Solid lines are calls in flight, dashed lines the current cap (absent when unlimited). A solid line pinned to its dashed line is a slow backend filling the bulkhead; under the adaptive bulkhead the dashed line saws up and down. A dashed line climbing one step per call right after a recovery is the recovery ramp (go_breaker_ramping == 1), not a problem.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "max by (dependency) (go_breaker_in_flight{dependency=~\"$dependency\"})",
          "legendFormat": "{{dependency}} in flight",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "max by (dependency) (go_breaker_in_flight_limit{dependency=~\"$dependency\"} < Inf)",
          "legendFormat": "{{dependency}} limit",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* limit"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Open circuits",
      "description": "One row per open breaker. 'Next probe in' counts down to the next admitted probe; negative means the breaker is idle with its deadline passed and will go half-open on the next call (lazy expiry, not a fault). 'Consecutive trips' is how deep into exponential backoff it is.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "(go_breaker_open_until_timestamp_seconds{dependency=~\"$dependency\"} - time()) and on (dependency, instance) (go_breaker_state{state=\"open\"} == 1)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "go_breaker_consecutive_trips{dependency=~\"$dependency\"} and on (dependency, instance) (go_breaker_state{state=\"open\"} == 1)",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true
            },
            "renameByName": {
              "dependency": "Dependency",
              "instance": "Instance",
              "Value #A": "Next probe in",
              "Value #B": "Consecutive trips"
            },
            "indexByName": {
              "Dependency": 0,
              "Instance": 1,
              "Next probe in": 2,
              "Consecutive trips": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Dependency"
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Next probe in"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "range",
                    "options": {
                      "from": -1000000000000.0,
                      "to": 0,
                      "result": {
                        "text": "idle, probes on next call",
                        "color": "text",
                        "index": 0
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "orange",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 30
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Consecutive trips"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 2
                    },
                    {
                      "color": "red",
                      "value": 4
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Per instance",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 7,
          "type": "state-timeline",
          "title": "Circuit state per instance",
          "description": "One row per breaker instance. Use the dependency variable to narrow it; with a large fleet this is the drill-down view, not the overview.",
          "gridPos": {
            "x": 0,
            "y": 33,
            "w": 24,
            "h": 12
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${DS}"
              },
              "expr": "go_breaker_state{dependency=~\"$dependency\", state=\"half-open\"} * 1 + go_breaker_state{dependency=~\"$dependency\", state=\"open\"} * 2",
              "legendFormat": "{{dependency}} @ {{instance}}",
              "refId": "A"
            }
          ],
          "options": {
            "mergeValues": true,
            "showValue": "never",
            "alignValue": "left",
            "rowHeight": 0.85,
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": false
            },
            "tooltip": {
              "mode": "single",
              "sort": "none"
            }
          },
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "orange",
                    "value": 1
                  },
                  {
                    "color": "red",
                    "value": 2
                  }
                ]
              },
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": {
                      "text": "Closed",
                      "color": "green",
                      "index": 0
                    },
                    "1": {
                      "text": "Half-open",
                      "color": "orange",
                      "index": 1
                    },
                    "2": {
                      "text": "Open",
                      "color": "red",
                      "index": 2
                    }
                  }
                }
              ]
            },
            "overrides": []
          }
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Rate limiters",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 21,
          "type": "timeseries",
          "title": "Decisions per second, by result",
          "description": "Allowed, limited and error decisions per limiter. Stacked: the total height is demand, the limited band is what the quota is turning away.",
          "gridPos": {
            "x": 0,
            "y": 34,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${DS}"
              },
              "expr": "sum by (limiter, result) (rate(go_ratelimit_decisions_total{limiter=~\"$limiter\"}[$__rate_interval]))",
              "legendFormat": "{{limiter}} {{result}}",
              "refId": "A"
            }
          ],
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "min": 0,
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "drawStyle": "line",
                "lineWidth": 2,
                "fillOpacity": 60,
                "spanNulls": false,
                "stacking": {
                  "mode": "normal",
                  "group": "A"
                }
              }
            },
            "overrides": []
          }
        },
        {
          "id": 22,
          "type": "timeseries",
          "title": "Refused share",
          "description": "Limited decisions as a share of all decisions, per limiter. Inbound: how hard clients are being throttled. Outbound: how far over quota you are.",
          "gridPos": {
            "x": 12,
            "y": 34,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${DS}"
              },
              "expr": "sum by (limiter) (rate(go_ratelimit_decisions_total{limiter=~\"$limiter\",result=\"limited\"}[$__rate_interval]))\n  /\nsum by (limiter) (rate(go_ratelimit_decisions_total{limiter=~\"$limiter\"}[$__rate_interval]))",
              "legendFormat": "{{limiter}}",
              "refId": "A"
            }
          ],
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0,
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "drawStyle": "line",
                "lineWidth": 2,
                "fillOpacity": 10,
                "spanNulls": false
              }
            },
            "overrides": []
          }
        },
        {
          "id": 23,
          "type": "timeseries",
          "title": "Limiter errors",
          "description": "Decisions that could not be made: a distributed limiter whose Redis is unreachable or misbehaving. With the default fail-open middleware this is the only signal that limits are not being enforced.",
          "gridPos": {
            "x": 0,
            "y": 42,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${DS}"
              },
              "expr": "sum by (limiter) (rate(go_ratelimit_decisions_total{limiter=~\"$limiter\",result=\"error\"}[$__rate_interval]))",
              "legendFormat": "{{limiter}}",
              "refId": "A"
